@model AbcRetail.Models.AdminCustomerCreateViewModel
@{
    ViewData["Title"] = "Add Customer";
}

<section class="glass-panel" style="max-width:520px;margin:0 auto;">
    <h1 class="section-title">Add Customer</h1>
    <p class="section-lead">Create a staff or customer account.</p>

    <form asp-action="Create" method="post" class="form-grid">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label>
            First name
            <input asp-for="FirstName" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </label>
        <label>
            Last name
            <input asp-for="LastName" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </label>
        <label>
            Email
            <input asp-for="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </label>
        <label>
            Phone
            <input asp-for="Phone" />
        </label>
        <label>
            City
            <input asp-for="City" />
        </label>
        <label>
            Role
            <select asp-for="Role">
                <option value="Customer">Customer</option>
                <option value="Admin">Admin</option>
            </select>
        </label>
        <label>
            Password
            <input asp-for="Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </label>
        <label>
            Confirm password
            <input asp-for="ConfirmPassword" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </label>
        <div class="cta-row">
            <button type="submit" class="btn-accent">Save customer</button>
            <a class="btn-ghost" asp-action="Index">Back to list</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
