@model AbcRetail.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}

<section class="glass-panel auth-panel">
    <h1 class="section-title">Create your account</h1>
    <p class="section-lead">We’ll send a confirmation email to finish setup.</p>

    <form asp-action="Register" method="post" class="form-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label>
            First name
            <input asp-for="FirstName" autocomplete="given-name" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </label>
        <label>
            Last name
            <input asp-for="LastName" autocomplete="family-name" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </label>
        <label>
            Email
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </label>
        <label>
            Password
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </label>
        <label>
            Confirm password
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </label>
        <div class="cta-row">
            <button type="submit" class="btn-accent">Create account</button>
            <a class="btn-ghost" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Already have an account?</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
