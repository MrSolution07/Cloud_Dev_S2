@model AbcRetail.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}

<section class="glass-panel" style="max-width:520px;margin:0 auto;">
    <h1 class="section-title">Create your account</h1>
    <p class="section-lead">Your profile is stored in Azure Table Storage. Once registered you can add items to your cart and buy.</p>

    <form asp-action="Register" method="post" class="form-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label>
            First name
            <input asp-for="FirstName" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </label>
        <label>
            Last name
            <input asp-for="LastName" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </label>
        <label>
            Email
            <input asp-for="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </label>
        <label>
            Phone
            <input asp-for="Phone" />
        </label>
        <label>
            City
            <input asp-for="City" />
        </label>
        <label>
            Password
            <input asp-for="Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </label>
        <label>
            Confirm password
            <input asp-for="ConfirmPassword" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </label>
        <div class="cta-row">
            <button type="submit" class="btn-accent">Create account</button>
            <a class="btn-ghost" asp-action="Login">Already have an account?</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
