@model AbcRetail.Models.LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<section class="glass-panel auth-panel">
    <h1 class="section-title">Log in</h1>
    <p class="section-lead">Welcome back. Sign in to check out and track orders.</p>

    <form asp-action="Login" method="post" class="form-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label>
            Email
            <input asp-for="Email" autocomplete="username" placeholder="you@email.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </label>
        <label>
            Password
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </label>
        <div class="cta-row">
            <button type="submit" class="btn-accent">Log in</button>
            <a class="btn-ghost" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
        </div>
    </form>

    <aside class="staff-hint">
        <p class="staff-hint-label">Staff demo</p>
        <p><span>Email</span> <code>admin@abcretail.local</code></p>
        <p><span>Password</span> <code>Admin@12345</code></p>
    </aside>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
