@model IReadOnlyList<AbcRetail.Models.ProductEntity>
@{
    ViewData["Title"] = "Home";
    var ready = ViewBag.StorageReady as bool? ?? false;
}

<section class="hero">
    <p class="pill">New season arrivals</p>
    <h1 class="brand-mark">ABC Retail</h1>
    <p>Everyday essentials and standout finds, picked for quality and priced to make sense. Shop the catalog and check out in seconds.</p>
    <div class="cta-row">
        <a class="btn-accent" asp-controller="Products" asp-action="Index">Shop now</a>
        <a class="btn-ghost" asp-controller="Orders" asp-action="Index">Track my orders</a>
    </div>

    @if (!ready)
    {
        <div class="glass-panel" style="margin-top:1.5rem;">
            <h2 class="section-title" style="font-size:1.4rem;">Storage not configured</h2>
            <p class="section-lead" style="margin:0;">@(ViewBag.StorageMessage ?? "Set AzureStorage:ConnectionString (User Secrets locally, or App Setting AzureStorage__ConnectionString on App Service).")</p>
        </div>
    }

    <div class="feature-strip">
        <article>
            <h3>Fast shipping</h3>
            <p>Orders picked and processed the moment you check out.</p>
        </article>
        <article>
            <h3>Secure checkout</h3>
            <p>Your details stay protected from cart to delivery.</p>
        </article>
        <article>
            <h3>Easy returns</h3>
            <p>Not the right fit? Send it back, no hassle.</p>
        </article>
        <article>
            <h3>Real support</h3>
            <p>Questions about an order? We're here to help.</p>
        </article>
    </div>
</section>

@if (Model.Any())
{
    <section class="glass-panel">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h2 class="section-title" style="font-size:1.6rem;">Featured products</h2>
                <p class="section-lead">Popular picks from the current catalog.</p>
            </div>
            <a class="btn-glass" asp-controller="Products" asp-action="Index">View all</a>
        </div>

        <div class="product-grid">
            @foreach (var p in Model)
            {
                <article class="product-card">
                    <div class="product-card-media">
                        @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="product-card-placeholder">ABC</span>
                        }
                    </div>
                    <div class="product-card-body">
                        <h3>@p.Name</h3>
                        <p class="product-card-price">@p.Price.ToString("C")</p>
                    </div>
                </article>
            }
        </div>
    </section>
}
