@model IReadOnlyList<AbcRetail.Models.ProductEntity>
@{
    ViewData["Title"] = "Home";
    var ready = ViewBag.StorageReady as bool? ?? false;
}

<section class="hero">
    <p class="pill">New season</p>
    <h1 class="brand-mark">ABC Retail</h1>
    <p>Phones, laptops, audio, and more — priced in Rand, delivered fast.</p>
    <div class="cta-row">
        <a class="btn-accent" asp-controller="Products" asp-action="Index">Shop now</a>
        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
        {
            <a class="btn-ghost" asp-controller="Products" asp-action="Manage">Manage catalog</a>
        }
        else
        {
            <a class="btn-ghost" asp-controller="Cart" asp-action="Index">View cart</a>
        }
    </div>

    @if (!ready)
    {
        <div class="glass-panel" style="margin-top:1.5rem;">
            <h2 class="section-title" style="font-size:1.4rem;">Store temporarily unavailable</h2>
            <p class="section-lead" style="margin:0;">@(ViewBag.StorageMessage ?? "The catalog cannot load right now. Please try again shortly.")</p>
        </div>
    }

    <div class="feature-strip">
        <article>
            <h3>Fast shipping</h3>
            <p>Orders leave the warehouse as soon as payment clears.</p>
        </article>
        <article>
            <h3>Secure checkout</h3>
            <p>Card details are never stored. Pay in Rand with a protected session.</p>
        </article>
        <article>
            <h3>Easy returns</h3>
            <p>Changed your mind? Send it back within 30 days.</p>
        </article>
        <article>
            <h3>Real support</h3>
            <p>Questions about an order? We’re here to help.</p>
        </article>
    </div>
</section>

@if (Model.Any())
{
    <section class="glass-panel">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h2 class="section-title" style="font-size:1.6rem;">Featured</h2>
                <p class="section-lead">Popular picks from the current catalog.</p>
            </div>
            <a class="btn-glass" asp-controller="Products" asp-action="Index">View all</a>
        </div>

        <div class="product-grid">
            @foreach (var p in Model)
            {
                <a asp-controller="Products" asp-action="Details" asp-route-rowKey="@p.RowKey" class="product-card" style="text-decoration:none;color:inherit;">
                    <div class="product-card-media">
                        @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="product-card-placeholder">ABC</span>
                        }
                    </div>
                    <div class="product-card-body">
                        <h3>@p.Name</h3>
                        <p class="product-card-price">@p.Price.ToString("C")</p>
                    </div>
                </a>
            }
        </div>
    </section>
}
