@model AbcRetail.Models.ProductCreateViewModel
@{
    ViewData["Title"] = "Add product";
}

<section class="glass-panel">
    <h1 class="section-title">Add product</h1>
    <p class="section-lead">Upload up to 5 images (JPEG, PNG, WebP, or GIF — 1 MB each). The first image is the cover.</p>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="form-grid">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label>
            Name
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </label>
        <label>
            Description
            <textarea asp-for="Description" rows="6" placeholder="Materials, dimensions, what’s included…"></textarea>
        </label>
        <label>
            Price (ZAR)
            <input asp-for="Price" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </label>
        <label>
            Stock
            <input asp-for="Stock" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </label>
        <label>
            Category
            <select asp-for="Category">
                <option value="">Select category</option>
                @foreach (var cat in (ViewBag.Categories as IEnumerable<string> ?? AbcRetail.Services.ProductQuery.CanonicalCategories))
                {
                    <option value="@cat">@cat</option>
                }
            </select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </label>
        <label>
            Product images
            <input name="Images" type="file" accept="image/*" multiple />
            <span asp-validation-for="Images" class="text-danger"></span>
        </label>
        <div class="cta-row">
            <button type="submit" class="btn-accent">Save product</button>
            <a class="btn-ghost" asp-action="Manage">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
