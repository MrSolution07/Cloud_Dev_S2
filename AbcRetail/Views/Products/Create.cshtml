@model AbcRetail.Models.ProductCreateViewModel
@{
    ViewData["Title"] = "Add product";
}

<section class="glass-panel">
    <h1 class="section-title">Add product</h1>
    <p class="section-lead">Add a new product to the catalog — upload up to 5 images (JPEG/PNG/WebP/GIF, 1 MB each).</p>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="form-grid">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label>
            Name
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </label>
        <label>
            Description
            <textarea asp-for="Description" rows="6" placeholder="Materials, dimensions, capacity, what's included..."></textarea>
        </label>
        <label>
            Price (ZAR)
            <input asp-for="Price" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </label>
        <label>
            Stock
            <input asp-for="Stock" />
        </label>
        <label>
            Product images (select up to 5 — first one becomes the cover image)
            <input name="Images" type="file" accept="image/*" multiple />
            <span asp-validation-for="Images" class="text-danger"></span>
        </label>
        <div class="cta-row">
            <button type="submit" class="btn-accent">Save product</button>
            <a class="btn-ghost" asp-action="Manage">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
