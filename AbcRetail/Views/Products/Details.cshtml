@model AbcRetail.Models.ProductEntity
@{
    ViewData["Title"] = Model.Name;
    var gallery = ViewBag.GalleryUrls as List<string> ?? new List<string>();
}

<section class="glass-panel product-detail">
    <div class="product-gallery">
        @if (gallery.Any())
        {
            <div class="product-gallery-main">
                <img id="mainImage" src="@gallery[0]" alt="@Model.Name" />
            </div>
            @if (gallery.Count > 1)
            {
                <div class="product-gallery-thumbs">
                    @foreach (var url in gallery)
                    {
                        <img src="@url" alt="@Model.Name" class="gallery-thumb" onclick="document.getElementById('mainImage').src=this.src" />
                    }
                </div>
            }
        }
        else
        {
            <div class="product-gallery-main product-card-placeholder-large">ABC</div>
        }
    </div>

    <div class="product-detail-body">
        <h1 class="section-title">@Model.Name</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Category))
        {
            <p class="pill">@Model.Category</p>
        }
        <p class="product-card-price" style="font-size:1.5rem;">@Model.Price.ToString("C")</p>

        @if (Model.Stock <= 0)
        {
            <span class="stock-badge out" style="position:static;display:inline-block;">Out of stock</span>
        }
        else if (Model.Stock <= 5)
        {
            <span class="stock-badge low" style="position:static;display:inline-block;">Only @Model.Stock left</span>
        }
        else
        {
            <span class="pill">In stock: @Model.Stock</span>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="product-copy">@Model.Description</p>
        }

        <div class="cta-row" style="margin-top:1rem;">
            @if (User.IsInRole("Admin"))
            {
                <a class="btn-accent" asp-action="Edit" asp-route-rowKey="@Model.RowKey">Edit product</a>
            }
            else
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="qty-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productRowKey" value="@Model.RowKey" />
                    <input type="number" name="quantity" value="1" min="1" max="@(Model.Stock > 0 ? Model.Stock : 1)" @(Model.Stock <= 0 ? "disabled" : null) />
                    <button type="submit" class="btn-accent" @(Model.Stock <= 0 ? "disabled" : null)>Add to cart</button>
                </form>
            }
            <a class="btn-ghost" asp-action="Index">Back to shop</a>
        </div>
    </div>
</section>
