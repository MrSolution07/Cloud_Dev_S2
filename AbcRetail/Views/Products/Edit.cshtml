@model AbcRetail.Models.ProductCreateViewModel
@{
    ViewData["Title"] = "Edit product";
    var existing = ViewBag.ExistingImages as List<string> ?? new List<string>();
}

<section class="glass-panel">
    <h1 class="section-title">Edit product</h1>
    <p class="section-lead">Update details. Extra images are appended (5 total).</p>

    @if (existing.Any())
    {
        <div class="product-gallery-thumbs" style="margin-bottom:1rem;">
            @foreach (var url in existing)
            {
                <img src="@url" alt="Existing image" class="gallery-thumb" />
            }
        </div>
    }

    <form asp-action="Edit" asp-route-rowKey="@ViewBag.RowKey" method="post" enctype="multipart/form-data" class="form-grid">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label>
            Name
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </label>
        <label>
            Description
            <textarea asp-for="Description" rows="6"></textarea>
        </label>
        <label>
            Price (ZAR)
            <input asp-for="Price" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </label>
        <label>
            Stock
            <input asp-for="Stock" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </label>
        <label>
            Category
            <select asp-for="Category">
                <option value="">Select category</option>
                @foreach (var cat in (ViewBag.Categories as IEnumerable<string> ?? AbcRetail.Services.ProductQuery.CanonicalCategories))
                {
                    <option value="@cat">@cat</option>
                }
            </select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </label>
        <label>
            Add images (optional)
            <input name="Images" type="file" accept="image/*" multiple />
            <span asp-validation-for="Images" class="text-danger"></span>
        </label>
        <div class="cta-row">
            <button type="submit" class="btn-accent">Save changes</button>
            <a class="btn-ghost" asp-action="Manage">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
