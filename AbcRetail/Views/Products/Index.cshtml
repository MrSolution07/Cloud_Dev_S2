@model IReadOnlyList<AbcRetail.Models.ProductEntity>
@{
    ViewData["Title"] = "Shop";
}

<section class="glass-panel">
    <div>
        <h1 class="section-title">Shop</h1>
        <p class="section-lead">Browse the catalog, search, and add items to your cart. Prices are in ZAR.</p>
    </div>
    <form method="get" class="shop-filters">
        <input type="search" name="q" value="@ViewBag.Query" placeholder="Search products" />
        <select name="category">
            <option value="">All categories</option>
            @foreach (var cat in (ViewBag.Categories as string[] ?? Array.Empty<string>()))
            {
                if (cat == (string?)ViewBag.Category)
                {
                    <option value="@cat" selected>@cat</option>
                }
                else
                {
                    <option value="@cat">@cat</option>
                }
            }
        </select>
        <button type="submit" class="btn-glass">Filter</button>
    </form>

    @if (!Model.Any())
    {
        <p>No products available right now — check back soon.</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var p in Model)
            {
                <article class="product-card">
                    <a asp-action="Details" asp-route-rowKey="@p.RowKey" class="product-card-media">
                        @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="product-card-placeholder">ABC</span>
                        }
                        @if (p.Stock <= 0)
                        {
                            <span class="stock-badge out">Out of stock</span>
                        }
                        else if (p.Stock <= 5)
                        {
                            <span class="stock-badge low">Only @p.Stock left</span>
                        }
                    </a>
                    <div class="product-card-body">
                        <h3><a asp-action="Details" asp-route-rowKey="@p.RowKey">@p.Name</a></h3>
                        @if (!string.IsNullOrWhiteSpace(p.Description))
                        {
                            <p class="product-card-desc">@p.Description</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.Category))
                        {
                            <p class="product-card-desc">@p.Category</p>
                        }
                        <p class="product-card-price">@p.Price.ToString("C")</p>
                        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
                        {
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productRowKey" value="@p.RowKey" />
                                <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Products", new { q = ViewBag.Query, category = ViewBag.Category })" />
                                <div class="qty-form">
                                    <input type="number" name="quantity" value="1" min="1" max="@(p.Stock > 0 ? p.Stock : 1)" @(p.Stock <= 0 ? "disabled" : null) />
                                    <button type="submit" class="btn-accent" @(p.Stock <= 0 ? "disabled" : null)>Add to cart</button>
                                </div>
                            </form>
                        }
                        else if (User.IsInRole("Admin"))
                        {
                            <a class="btn-ghost" asp-action="Edit" asp-route-rowKey="@p.RowKey">Edit</a>
                        }
                        else
                        {
                            <a class="btn-accent" style="width:100%;text-align:center;"
                               asp-controller="Account" asp-action="Login"
                               asp-route-returnUrl="@Url.Action("Details", "Products", new { rowKey = p.RowKey })">Log in to buy</a>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
