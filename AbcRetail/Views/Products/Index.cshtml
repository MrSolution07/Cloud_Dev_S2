@model IReadOnlyList<AbcRetail.Models.ProductEntity>
@{
    ViewData["Title"] = "Shop";
    var selectedCategory = (string?)ViewBag.Category;
    var selectedSort = (string?)ViewBag.Sort;
    var query = (string?)ViewBag.Query;
    var categories = ViewBag.Categories as IEnumerable<string> ?? Array.Empty<string>();
    var total = ViewBag.TotalCount as int? ?? Model.Count;
    var filtered = Model.Count != total || !string.IsNullOrWhiteSpace(query) || !string.IsNullOrWhiteSpace(selectedCategory);
    var isAdmin = User.IsInRole("Admin");
}

<section class="glass-panel">
    <div>
        <h1 class="section-title">Shop</h1>
        <p class="section-lead">Browse the catalog. Prices in ZAR.</p>
    </div>
    <form method="get" class="shop-filters" role="search">
        <input type="search" name="q" value="@query" placeholder="Search products" />
        <select name="sort" aria-label="Sort">
            @if (string.IsNullOrWhiteSpace(selectedSort))
            {
                <option value="" selected>Newest</option>
            }
            else
            {
                <option value="">Newest</option>
            }
            @if (string.Equals(selectedSort, "price-asc", StringComparison.OrdinalIgnoreCase))
            {
                <option value="price-asc" selected>Price: low to high</option>
            }
            else
            {
                <option value="price-asc">Price: low to high</option>
            }
            @if (string.Equals(selectedSort, "price-desc", StringComparison.OrdinalIgnoreCase))
            {
                <option value="price-desc" selected>Price: high to low</option>
            }
            else
            {
                <option value="price-desc">Price: high to low</option>
            }
        </select>
        <input type="hidden" name="category" value="@selectedCategory" />
        <button type="submit" class="btn-glass">Search</button>
        @if (filtered)
        {
            <a class="btn-ghost" asp-action="Index">Clear</a>
        }
    </form>
    @if (categories.Any())
    {
        <div class="category-chips" role="navigation" aria-label="Categories">
            <a class="chip @(string.IsNullOrWhiteSpace(selectedCategory) ? "is-active" : null)"
               asp-action="Index" asp-route-q="@query" asp-route-sort="@selectedSort">All</a>
            @foreach (var cat in categories)
            {
                var active = string.Equals(cat, selectedCategory, StringComparison.OrdinalIgnoreCase);
                <a class="chip @(active ? "is-active" : null)"
                   asp-action="Index" asp-route-q="@query" asp-route-category="@cat" asp-route-sort="@selectedSort">@cat</a>
            }
        </div>
    }
    <p class="filter-meta">@(filtered ? $"Showing {Model.Count} of {total} products" : $"{Model.Count} products")</p>

    @if (!Model.Any())
    {
        if (total == 0)
        {
            <p>No products available right now — check back soon.</p>
        }
        else
        {
            <p>No products match this search. <a asp-action="Index">Clear filters</a></p>
        }
    }
    else
    {
        <div class="product-grid">
            @foreach (var p in Model)
            {
                <article class="product-card">
                    <a asp-action="Details" asp-route-rowKey="@p.RowKey" class="product-card-media">
                        @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="product-card-placeholder">ABC</span>
                        }
                        @if (p.Stock <= 0)
                        {
                            <span class="stock-badge out">Out of stock</span>
                        }
                        else if (p.Stock <= 5)
                        {
                            <span class="stock-badge low">Only @p.Stock left</span>
                        }
                    </a>
                    <div class="product-card-body">
                        <h3><a asp-action="Details" asp-route-rowKey="@p.RowKey">@p.Name</a></h3>
                        <p class="product-card-price">@p.Price.ToString("C")</p>
                        @if (isAdmin)
                        {
                            <a class="btn-ghost" asp-action="Edit" asp-route-rowKey="@p.RowKey">Edit</a>
                        }
                        else
                        {
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productRowKey" value="@p.RowKey" />
                                <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Products", new { q = query, category = selectedCategory, sort = selectedSort })" />
                                <div class="qty-form">
                                    <input type="number" name="quantity" value="1" min="1" max="@(p.Stock > 0 ? p.Stock : 1)" @(p.Stock <= 0 ? "disabled" : null) />
                                    <button type="submit" class="btn-accent" @(p.Stock <= 0 ? "disabled" : null)>Add to cart</button>
                                </div>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
