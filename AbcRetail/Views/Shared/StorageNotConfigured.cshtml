@model string?
@{
    ViewData["Title"] = "Store unavailable";
}

<section class="glass-panel">
    <h1 class="section-title">Store temporarily unavailable</h1>
    <p class="section-lead">@(Model ?? "The catalog cannot load right now. Please try again shortly.")</p>
    <a class="btn-glass" asp-controller="Home" asp-action="Index">Back home</a>
</section>
