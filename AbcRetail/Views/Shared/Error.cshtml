@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="glass-panel" style="max-width:640px;margin:0 auto;">
    <p class="pill">Error</p>
    <h1 class="section-title">We could not complete that request</h1>
    <p class="section-lead">Try again in a moment. If you were checking out, your cart is still saved and no payment was captured unless you already saw a confirmation page.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Request ID <code>@Model.RequestId</code></p>
    }
    <div class="cta-row">
        <a class="btn-accent" asp-controller="Home" asp-action="Index">Home</a>
        <a class="btn-ghost" asp-controller="Products" asp-action="Index">Shop</a>
    </div>
</section>
