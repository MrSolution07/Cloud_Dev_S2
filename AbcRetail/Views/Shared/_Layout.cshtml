<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ABC Retail</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Sora:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="atmosphere" aria-hidden="true"></div>
    <header class="site-header">
        <nav class="glass-nav">
            <a class="brand" asp-controller="Home" asp-action="Index">ABC Retail</a>
            <button class="nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">Menu</button>
            <div class="collapse navbar-collapse nav-center" id="mainNav">
                <ul class="nav-links">
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li><a asp-controller="Customers" asp-action="Index">Customers</a></li>
                        <li><a asp-controller="Products" asp-action="Manage">Products</a></li>
                        <li><a asp-controller="Orders" asp-action="Index">Orders</a></li>
                        <li><a asp-controller="Logs" asp-action="Index">Logs</a></li>
                    }
                    else
                    {
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Products" asp-action="Index">Shop</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li>
                                <a asp-controller="Cart" asp-action="Index">Cart @await Component.InvokeAsync("CartCount")</a>
                            </li>
                        }
                        <li><a asp-controller="Home" asp-action="Privacy">About</a></li>
                    }
                </ul>
            </div>
            <ul class="nav-auth">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-dropdown dropdown">
                        <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">@User.Identity!.Name</a>
                        <ul class="dropdown-menu admin-dropdown">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">My profile</a></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">View shop</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" asp-controller="Orders" asp-action="Mine">My orders</a></li>
                            }
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item" style="background:none;border:none;width:100%;text-align:left;cursor:pointer;">Log out</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li><a asp-controller="Account" asp-action="Login">Log in</a></li>
                    <li><a asp-controller="Account" asp-action="Register">Register</a></li>
                }
            </ul>
        </nav>
    </header>

    <main class="page-shell">
        @if (TempData["Status"] is string status)
        {
            <div class="glass-alert success fade-in">@status</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="glass-alert danger fade-in">@error</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div>
                <p class="footer-brand">ABC Retail</p>
                <p class="footer-tag">@(User.IsInRole("Admin") ? "Azure Storage • Command Centre" : "Everyday essentials, delivered fast.")</p>
            </div>
            <div class="footer-links">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Home" asp-action="Index">Dashboard</a>
                    <a asp-controller="Orders" asp-action="Index">Orders</a>
                    <a asp-controller="Logs" asp-action="Index">Logs</a>
                }
                else
                {
                    <a asp-controller="Products" asp-action="Index">Shop</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Cart" asp-action="Index">Cart</a>
                        <a asp-controller="Orders" asp-action="Mine">Orders</a>
                    }
                    <a asp-controller="Home" asp-action="Privacy">About</a>
                }
            </div>
        </div>
        <p class="footer-copy">© @DateTime.UtcNow.Year ABC Retail. All rights reserved.</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
